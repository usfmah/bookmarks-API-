# FOLIO — root environment file (copy to .env, fill in values).
# The root .env is used by docker compose for variable substitution.
# It is NOT committed to git (see .gitignore).

# --- PostgreSQL container ---
POSTGRES_DB=folio
POSTGRES_USER=folio
# REQUIRED — choose a strong, unique password. Never commit the real value.
POSTGRES_PASSWORD=change-me

# --- Backend ---
# REQUIRED — random string used to sign JWTs. Generate e.g. with: openssl rand -hex 32
JWT_SECRET=change-me
# Browser origin allowed by CORS (the frontend's URL)
FRONTEND_URL=http://localhost:4200

# --- Ports ---
# Host port the frontend is published on
FRONTEND_PORT=4200

# Host port the backend is published on.
# The Angular dev server targets this port (see frontend/src/environments/environment.development.ts).
BACKEND_PORT=2296
